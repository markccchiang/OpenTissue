#-------------------------------------------------------------------------------
#
# CMake package configuration for OpenTissue.
#
# Importing this package defines the following targets:
#
#   OpenTissue::headers : Interface target carrying the OpenTissue include
#                         directories, the Boost include directories and the
#                         compiler definitions OpenTissue needs. This is what
#                         applications link.
#   OpenTissue::depends : Empty interface target, reserved for third-party
#                         linkage. Exported for compatibility; linking it does
#                         nothing today.
#
# Typical use:
#
#   set(OpenTissue_ROOT "path-to-opentissue-build-or-install-dir")
#   find_package(OpenTissue REQUIRED)
#   target_link_libraries(MyProject PRIVATE OpenTissue::headers)
#
# OpenTissue is header-only, so there is nothing to link beyond Boost. The
# optional third-party libraries (TinyXML, Qhull, TetGen, Triangle, libpng) are
# only needed by the specific headers that use them; if your application
# includes one of those, find and link that library yourself.
#
#-------------------------------------------------------------------------------

set(OPENTISSUE_VERSION @OpenTissue_VERSION@)

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# CMake 4 removed the bundled FindBoost module in favour of BoostConfig.cmake.
if(POLICY CMP0167)
  cmake_policy(SET CMP0167 NEW)
endif()

# Boost is a genuine hard dependency: OpenTissue::headers links the
# Boost::disable_autolinking target, so that target must exist before
# OpenTissueTargets.cmake is imported below.
find_dependency(Boost @OPENTISSUE_BOOST_VERSION@)

check_required_components(OpenTissue)

include("${CMAKE_CURRENT_LIST_DIR}/OpenTissueTargets.cmake")
